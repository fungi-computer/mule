{
  "name": "@fungi.computer/mule",
  "version": "0.3.0",
  "author": "Levi <levi@technomancy.dev>",
  "description": "Effect-native Pi model and tool loop",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./effect": {
      "types": "./dist/effect.d.ts",
      "import": "./dist/effect.js"
    },
    "./assistant-text": {
      "types": "./dist/assistant-text.d.ts",
      "import": "./dist/assistant-text.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js"
    }
  },
  "files": [
    "dist",
    "docs/api",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "pnpm run clean && tsc -p tsconfig.build.json",
    "clean": "node --input-type=module --eval \"import { rm } from 'node:fs/promises'; await rm('dist', { recursive: true, force: true });\"",
    "smoke": "node --input-type=module -e \"import('./dist/index.js').then(({mule}) => { if (!mule.run) process.exit(1); })\""
  },
  "dependencies": {
    "@earendil-works/pi-ai": "1.5.2",
    "@fungi.computer/cairn": "0.1.0",
    "effect": "4.0.2",
    "typebox": "1.3.27"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  },
  "botanical": {
    "role": "package",
    "operations": {
      "lint": "required",
      "typecheck": "required",
      "build": "required",
      "test": "required",
      "docs": "required",
      "pack": "required",
      "smoke": "required",
      "stranger": "required"
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fungi-computer/mule.git"
  }
}
